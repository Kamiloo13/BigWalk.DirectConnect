<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BigWalk.DirectConnect</AssemblyName>
    <RootNamespace>BigWalk.DirectConnect</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- BIG WALK install folder (the one containing "Big Walk.exe").
         Override without editing: dotnet build -c Release -p:GamePath="D:\Games\Big Walk" -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BIG WALK</GamePath>
    <BepInExCore>$(GamePath)\BepInEx\core</BepInExCore>
    <BepInExInterop>$(GamePath)\BepInEx\interop</BepInExInterop>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- BepInEx 6 / Harmony / Il2CppInterop -->
  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- Game + Unity assemblies (generated by BepInEx in BepInEx\interop on first launch).
       Mirror/kcp2k are not referenced: they are reached via reflection (Common/Reflect.cs). -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(BepInExInterop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(BepInExInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(BepInExInterop)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BepInExInterop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(BepInExInterop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(BepInExInterop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(BepInExInterop)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Copy the DLL to BepInEx\plugins\BigWalk.DirectConnect\ after every build. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins\$(AssemblyName)" />
    <Message Importance="high" Text="$(AssemblyName) -&gt; $(GamePath)\BepInEx\plugins\$(AssemblyName)" />
  </Target>

</Project>
